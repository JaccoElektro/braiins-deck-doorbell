#!/bin/sh /etc/rc.common
# Listen to the doorbell from boot, and restart the listener if it ever stops.
START=99
USE_PROCD=1

start_service() {
	[ -s /etc/doorbell/vto.conf ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/doorbell run
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
